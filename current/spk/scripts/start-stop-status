#!/bin/sh

mcconfigEnabled="/var/packages/mcconfig/enabled"
mcconfigBin="/var/packages/mcconfig/target/bin/mcconfig"
mcconfigConf="/var/packages/mcconfig/target/mcconfig.conf"
mcconfigUIDir="/usr/syno/synoman/webman/3rdparty/mcconfig"
mcconfigLog="/var/packages/mcconfig/target/debug.log"
RotateLogBin="/var/packages/mcconfig/target/bin/rotatelogs"
ApacheConf="/usr/syno/apache/conf/httpd.conf-user"
PkgName="mcconfig"
PkgTopDir="/var/packages/${PkgName}"
mcconfigTarget="${PkgTopDir}/target"
mcconfigUI="${mcconfigTarget}/ui"
DSM_INDEX_ADD="/usr/syno/bin/pkgindexer_add"
DSM_INDEX_DEL="/usr/syno/bin/pkgindexer_del"


if [ ! -z "$SYNOPKG_PKGDEST" -a -z "$SYNOPKG_DSM_VERSION_MAJOR" ];then
	# From UI. We need to do this. So we will not run the start script
	# at boot time when the package is disabled.
	# When the package is enabled, we would like to run the start script.
	# So we can correct the httpd.conf after DS firmware upgrade
	# The version 731 does not touch the file enabled for us. So we have to
	# do it our self.
	case "$1" in
		start)
			touch $mcconfigEnabled;
			;;
		stop)
			rm -f $mcconfigEnabled
			;;
	esac
fi

case "$1" in
	start)
		if [ ! -f "$mcconfigEnabled" -a -z "$SYNOPKG_DSM_VERSION_MAJOR" ]; then
			exit;
		fi
		if [ ! -L "/var/services/web" ]; then
			date >> $mcconfigLog
			echo "web shared folder does not exist." >> $mcconfigLog
			echo "Please enable Web Station before enable the mcconfig." >> $mcconfigLog
			exit 1
		fi

		if [ ! -d "/var/services/web/mcconfig" ]; then
			mkdir /var/services/web/mcconfig
			
			cp -rf /var/packages/mcconfig/target/bin/* /var/services/web/mcconfig					
			chmod -R 777 /var/services/web/mcconfig					
			
			if [ $? != 0 ]; then
				date >> $mcconfigLog
				echo "Failed to create mcconfig directory in web shared folder." >> $mcconfigLog
				exit 1
			else
				date >> $mcconfigLog
				echo "Create the web/mcconfig to store web statistic." >> $mcconfigLog
			fi
		fi
		
		
		
		if [ -d "/volume1/@appstore/Minecraft" ]; then
			chmod -R 777 /volume1/@appstore/Minecraft
			chown -R minecraft:users /volume1/@appstore/Minecraft
		fi
		
		if [ -d "/volume1/@appstore/Craftbukkit" ]; then
			chmod -R 777 /volume1/@appstore/Craftbukkit
			chown -R craftbukkit:users /volume1/@appstore/Craftbukkit
		fi
		
		

		# Execute the mcconfig once. So we will have data before crontab run it.
		$mcconfigBin -c $mcconfigConf

		# Put the mcconfig to crontab
		/bin/grep $mcconfigBin /etc/crontab > /dev/null 2>&1
		if [ $? != 0 ]; then
			echo "13	*	*	*	*	root	$mcconfigBin -c $mcconfigConf" >> /etc/crontab
			kill -1 `cat /var/run/crond.pid`
		fi

		# Enable desktop icon
		rm -f $mcconfigUIDir
		if [ -n "$SYNOPKG_DSM_VERSION_MAJOR" -a $SYNOPKG_DSM_VERSION_MAJOR -ge 4 ]; then
			ln -sf ${mcconfigUI} $mcconfigUIDir
			${DSM_INDEX_ADD} ${mcconfigUI}/index.conf
		else
			ln -sf ${mcconfigTarget}/desktop $mcconfigUIDir
		fi

		;;
	stop)
		if [ -f "$mcconfigEnabled" -a -z "$SYNOPKG_DSM_VERSION_MAJOR" ]; then
			exit;
		fi
		
		if [ -d "/volume1/@appstore/Minecraft" ]; then
			chmod -R 644 /volume1/@appstore/Minecraft
			find /volume1/@appstore/Minecraft/ -type d -exec chmod 0755 {} \;
			chown -R minecraft:root /volume1/@appstore/Minecraft
		fi
		
		if [ -d "/volume1/@appstore/Craftbukkit" ]; then
			chmod -R 644 /volume1/@appstore/Craftbukkit
			find /volume1/@appstore/Craftbukkit/ -type d -exec chmod 0755 {} \;
			chown -R minecraft:root /volume1/@appstore/Craftbukkit
		fi
				
		# Remove mcconfig from crontab
		/bin/grep $mcconfigBin /etc/crontab > /dev/null 2>&1
		if [ $? = 0 ]; then
			/bin/grep -v $mcconfigBin /etc/crontab > /etc/crontab.tmp
			/bin/mv /etc/crontab.tmp /etc/crontab
			kill -1 `cat /var/run/crond.pid`
		fi

		# Disable desktop icon
		if [ -n "$SYNOPKG_DSM_VERSION_MAJOR" -a $SYNOPKG_DSM_VERSION_MAJOR -ge 4 ]; then
			${DSM_INDEX_DEL} ${mcconfigUI}/index.conf
		fi
		if [ -d "$mcconfigUIDir" ]; then
			rm -rf $mcconfigUIDir
		fi

		;;
	status)
		/bin/grep $mcconfigBin /etc/crontab > /dev/null 2>&1
		if [ $? = 0 ]; then
			exit 0;
		fi
		exit 1
		;;
	log)
		echo $mcconfigLog
		;;
	*)
		echo "Usage: $0 {start|stop|status|log}" >&2
		exit 1
		;;
esac

exit 0

